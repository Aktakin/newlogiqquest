{
  "framework": null,
  "installCommand": "npm install --foreground-scripts",
  "buildCommand": "npm run build",
  "outputDirectory": "packages/client/dist",
  "rewrites": [
    { "source": "/api/:path*", "destination": "/api" },
    { "source": "/((?!api/).*)", "destination": "/index.html" }
  ]
}
